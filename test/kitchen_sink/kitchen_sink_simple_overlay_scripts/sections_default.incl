INCLUDE "sections_default_text.incl"
INCLUDE "sections_default_data.incl"

SECTIONS
{
    PROVIDE(__overlays_start__ = .);
    OVERLAY : {
        .overlay_first {
            KEEP (*(.first*))
            . = ALIGN(4);
        }
        .overlay_second {
            KEEP (*(.second*))
            . = ALIGN(4);
        }
    } > RAM AT> RAM_STORE
    PROVIDE(__overlays_end__ = .);
}

INCLUDE "section_heap.incl"
INCLUDE "sections_scratch.incl"
INCLUDE "section_flash_end.incl"
INCLUDE "section_end.incl"
INCLUDE "section_platform_end.incl"
