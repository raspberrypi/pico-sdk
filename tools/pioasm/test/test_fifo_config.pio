// run: pioasm -v 1 input.pio
.program fifo_tx
.pio_version 1
.fifo tx
    pull
    out pins, 8

.program fifo_rx
.pio_version 1
.fifo rx
    in pins, 8
    push

.program fifo_putget
.pio_version 1
.fifo putget
    mov osr, rxfifo[0]
    mov txfifo[0], isr

// -- Output
// Command: pioasm -v 1 input.pio
// Exit code: 1
// Stdout:
// Stderr:
// input.pio:18.9-14: syntax error, unexpected txfifo
//    18 |     mov txfifo[0], isr
//       |         ^~~~~~
// 
