// run: pioasm -v 1 input.pio
// Test program combining ALL configuration directives at once
.program everything_kitchen_sink
.pio_version 1
.clock_div 4.25
.side_set 2 opt pindirs
.origin 10
.define PUBLIC test_constant 42
.mov_status txfifo < 16
.fifo txrx
.out 8 right auto 28
.in 12 right auto 20
.set 3
.wrap_target
    set pins, 3 side 2 [3]
    out pins, 8 side 1 [2]
    in pins, 12 [3]
    mov x, status side 3
    push block
    pull block side 0 [1]
.wrap

