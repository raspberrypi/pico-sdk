// run: pioasm -v 1 input.pio
.program mov_combo
.pio_version 1
    mov x, y
    mov y, x
    mov isr, osr
    mov osr, isr
    mov pins, x
    mov x, pins
    mov pindirs, x
    mov pc, x
    mov exec, y
    mov x, null
    mov y, status

