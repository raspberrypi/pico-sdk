// run: pioasm -o json input.pio
.define public GLOBAL_CONST 2
.program json_cov
.pio_version 1
.lang_opt json some_option = 1
.side_set 2 opt pindirs
.define public LOCAL_CONST 3
public entry:
    nop side 0
    jmp entry

.program json_no_sideset
.origin 5
    nop
