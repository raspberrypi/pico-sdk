// run: pioasm -o c-sdk input.pio
.program fifo_txput
.pio_version 1
.fifo txput
    nop

.program fifo_txget
.pio_version 1
.fifo txget
    nop

.program fifo_putget
.pio_version 1
.fifo putget
    nop
