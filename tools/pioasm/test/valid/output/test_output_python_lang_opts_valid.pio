// run: pioasm -o python input.pio
.define PUBLIC global_const 1
.program python_opts
.pio_version 1
.side_set 1 opt
.lang_opt python out_shiftdir = 1
.lang_opt python autopull = 1
.define PUBLIC local_const 2
.wrap_target
public entry:
    nop side 1
    jmp entry
    .word 0xffff
.wrap
%python {
# python block for output
%}
