// run: pioasm input.pio
.program expr_bitwise
.define a 0x3
.define b 0x5
    set pins, (a | b)
    set pins, (a & b)
    set pins, (a ^ b)
    set pins, (1 << 4)
    set pins, (16 >> 2)

