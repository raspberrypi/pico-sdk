// run: pioasm -v 1 input.pio
.program directives_test
.pio_version 1
.clock_div 2.5
.side_set 2 opt
.origin 3
.define PUBLIC myconst 42
.mov_status txfifo < 4
.fifo txrx
.out 4
.in 3
.set 5
.wrap_target
    nop side 1
    pull
    out pins, 4
    in pins, 3
    set pins, 5
    .word 0xa042
.wrap

