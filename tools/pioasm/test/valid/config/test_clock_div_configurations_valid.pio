// run: pioasm input.pio
.program clock_div_integer
.clock_div 1
    nop

.program clock_div_fractional
.clock_div 2.5
    nop

.program clock_div_small_fraction
.clock_div 1.125
    nop

.program clock_div_large_fraction
.clock_div 123.75
    nop

.program clock_div_max_integer
.clock_div 65535
    nop

.program clock_div_complex
.clock_div 3.14159
    nop

