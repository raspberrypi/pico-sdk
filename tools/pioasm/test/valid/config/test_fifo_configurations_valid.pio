// run: pioasm -v 1 input.pio
.program fifo_comprehensive
.pio_version 1
.fifo tx
    nop

.program fifo_comprehensive_rx
.pio_version 1
.fifo rx
    nop

.program fifo_comprehensive_txrx
.pio_version 1
.fifo txrx
    nop

.program fifo_comprehensive_txput
.pio_version 1
.fifo txput
    nop

.program fifo_comprehensive_txget
.pio_version 1
.fifo txget
    nop

.program fifo_comprehensive_putget
.pio_version 1
.fifo putget
    nop

.program fifo_with_push_pull_txrx
.pio_version 1
.fifo txrx
    push
    pull

.program fifo_with_push_pull_rx
.pio_version 1
.fifo rx
    push
    pull

