// run: pioasm input.pio
.program sideset_1
.side_set 1
    nop side 0
    nop side 1

.program sideset_opt
.side_set 2 opt
    nop
    nop side 3

.program sideset_pindirs
.side_set 3 opt pindirs
    nop side 7

