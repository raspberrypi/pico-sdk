// run: pioasm -v 1 input.pio
.program mov_status_tx_lessthan
.pio_version 1
.mov_status txfifo < 4
    mov x, status
    nop

.program mov_status_tx_zero
.pio_version 1
.mov_status txfifo < 0
    mov x, status

.program mov_status_tx_max
.pio_version 1
.mov_status txfifo < 31
    mov x, status

.program mov_status_rx_lessthan
.pio_version 1
.mov_status rxfifo < 8
    mov y, status

.program mov_status_rx_max
.pio_version 1
.mov_status rxfifo < 31
    mov y, status

.program mov_status_irq_set
.pio_version 1
.mov_status irq set 5
    mov isr, status

.program mov_status_irq_zero
.pio_version 1
.mov_status irq set 0
    mov isr, status

.program mov_status_irq_max
.pio_version 1
.mov_status irq set 7
    mov isr, status

.program mov_status_irq_rel
.pio_version 1
.mov_status irq prev set 3
    mov osr, status

