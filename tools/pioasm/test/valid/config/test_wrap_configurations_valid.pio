// run: pioasm input.pio
.program wrap_begin
.wrap_target
wrap_begin:
    nop
    jmp wrap_begin
.wrap

.program wrap_mid
wrap_mid:
    nop
.wrap_target
    nop
    jmp wrap_mid
.wrap

