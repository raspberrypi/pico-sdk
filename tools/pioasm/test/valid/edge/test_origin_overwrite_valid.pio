// run: pioasm input.pio
// Test that multiple .origin directives are allowed - last one wins

.program origin_overwrite_simple
.origin 5
.origin 10
    nop
    nop

.program origin_overwrite_multiple
.origin 0
.origin 15
.origin 20
    nop

