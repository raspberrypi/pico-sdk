// run: pioasm input.pio
// Test edge cases for wrap behavior

.program wrap_single_instruction
.wrap_target
    nop
.wrap

.program wrap_last_instruction
    nop
    nop
.wrap_target
    nop
.wrap

.program wrap_entire_program
.wrap_target
    nop
    nop
    nop
    nop
.wrap

.program wrap_skip_first
    nop  ; This instruction executes once, then never again
.wrap_target
    nop
    nop
.wrap

.program wrap_skip_last
.wrap_target
    nop
    nop
.wrap
    nop  ; This instruction never executes in normal flow

.program wrap_with_jmp_outside
.wrap_target
    jmp outside
    nop
.wrap
outside:
    nop  ; Can jump here but won't wrap back

.program wrap_nested_loops
.wrap_target
loop1:
    jmp x-- loop1  ; Inner loop
    jmp loop2      ; Outer loop
loop2:
    nop
.wrap

