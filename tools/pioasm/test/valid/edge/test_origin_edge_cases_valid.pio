// run: pioasm input.pio
// Test origin edge cases - what happens when programs are loaded at specific addresses

.program origin_zero_with_jumps
.origin 0
start:
    jmp start   ; Jump to address 0
    jmp end     ; Jump to address 1
end:
    nop

.program origin_at_end
.origin 29
    nop
    nop
    nop  ; Will be at addresses 29, 30, 31

.program origin_with_wrap_target
.origin 15
.wrap_target
    nop
    nop
.wrap

.program origin_affects_jmp
.origin 10
start:
    jmp start   ; Will encode as jmp 10 (absolute)
    nop

