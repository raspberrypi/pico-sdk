// run: pioasm -v 0 input.pio
.program pio_v0_jmppin_error
.pio_version 0
    wait 0 jmppin

.program pio_v0_irq_next_error
.pio_version 0
    irq next 0

.program pio_v0_fifo_error
.pio_version 0
.fifo tx
    pull

// -- Output
// Command: pioasm -v 0 input.pio
