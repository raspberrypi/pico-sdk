load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:defs.bzl", "compatible_with_rp2")

package(default_visibility = ["//visibility:public"])

# The only code which handles the device identity private key.
cc_library(
    name = "pico_rpi_connect_identity_key",
    srcs = [
        "include/pico/rpi_connect/internal/connect_identity.h",
        "rpi_connect_identity.c",
        "rpi_connect_identity_key.c",
    ],
    hdrs = ["include/pico/rpi_connect_identity.h"],
    includes = ["include"],
    # OTP row holding the 32-byte P-256 device identity private key.
    # Override on the command line with
    # --copt=-DRPI_CONNECT_IDENTITY_OTP_ROW=0x... (a later -D wins).
    local_defines = ["RPI_CONNECT_IDENTITY_OTP_ROW=0xc0"],
    target_compatible_with = compatible_with_rp2(),
    deps = [
        "//src/rp2_common/pico_mbedtls",
    ],
)

cc_library(
    name = "pico_rpi_connect",
    srcs = [
        "connect_crypto.c",
        "connect_time.c",
        "include/pico/rpi_connect/internal/connect_http.h",
        "include/pico/rpi_connect/internal/connect_identity.h",
        "include/pico/rpi_connect/internal/connect_time.h",
        "include/pico/rpi_connect/internal/request.h",
        "include/pico/rpi_connect/internal/request_internal.h",
        "include/pico/rpi_connect/internal/rpi_connect_ca_cert.h",
        "include/pico/rpi_connect/internal/slist.h",
        "request.c",
        "request_lwip.c",
        "rpi_connect.c",
        "rpi_connect_http.c",
        "slist.c",
    ],
    hdrs = [
        "include/pico/rpi_connect.h",
        "include/pico/rpi_connect_identity.h",
        "include/pico/rpi_connect_util.h",
        # Internal header, but exported for tools such as the host
        # registration CLI.
        "include/pico/rpi_connect/internal/connect_crypto.h",
    ],
    includes = ["include"],
    target_compatible_with = compatible_with_rp2(),
    # rpi_connect_default_async_context() is declared in rpi_connect_util.h
    # but must be provided by the application (typically returning
    # cyw43_arch_async_context()), so this library does not depend on any
    # particular pico_cyw43_arch flavour.
    deps = [
        ":pico_rpi_connect_identity_key",
        "//src/common/pico_cjson",
        "//src/rp2_common/pico_async_context",
        "//src/rp2_common/pico_lwip",
        "//src/rp2_common/pico_lwip:pico_lwip_http",
        "//src/rp2_common/pico_mbedtls",
        "//src/rp2_common/pico_stdlib",
    ],
)

# Host build of the same library over system libcurl/OpenSSL instead of
# lwIP/mbedTLS (as used by the registration/debug CLI in pico-examples).
# Tagged manual because it needs the libcurl and OpenSSL development packages
# installed on the host.
cc_library(
    name = "pico_rpi_connect_host",
    srcs = [
        "connect_crypto.c",
        "connect_time.c",
        "include/pico/rpi_connect/internal/connect_identity.h",
        "include/pico/rpi_connect/internal/connect_time.h",
        "include/pico/rpi_connect/internal/request.h",
        "include/pico/rpi_connect/internal/request_internal.h",
        "include/pico/rpi_connect/internal/rpi_connect_ca_cert.h",
        "include/pico/rpi_connect/internal/slist.h",
        "request.c",
        "request_curl.c",
        "rpi_connect.c",
        "rpi_connect_identity.c",
        "rpi_connect_identity_key_host.c",
        "slist.c",
    ],
    hdrs = [
        "include/pico/rpi_connect.h",
        "include/pico/rpi_connect/internal/connect_crypto.h",
        "include/pico/rpi_connect_identity.h",
        "include/pico/rpi_connect_util.h",
    ],
    includes = ["include"],
    linkopts = [
        "-lcurl",
        "-lcrypto",
    ],
    tags = ["manual"],
    target_compatible_with = ["//bazel/constraint:host"],
    deps = [
        "//src/common/pico_base_headers:version",
        "//src/common/pico_cjson",
        "//src/common/pico_time",
        "//src/host/pico_platform",
        "//src/host/pico_stdlib",
    ],
)
