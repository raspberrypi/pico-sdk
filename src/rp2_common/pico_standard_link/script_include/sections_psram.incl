SECTIONS
{
    .psram_load : {
        __in_psram_start__ = .;
        __in_psram_load_start__ = .;
        *(SORT(.psram_initialised.*))
        . = ALIGN(4);
        __in_psram_load_end__ = .;
    } > PSRAM AT> PSRAM_STORE
    __in_psram_load_source__ = LOADADDR(.psram_load);

    .psram_noload (NOLOAD) : {
        *(SORT(.psram_uninitialised.*))
        . = ALIGN(4);
        __in_psram_end__ = .;
    } > PSRAM
}
